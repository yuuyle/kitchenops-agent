PORT=8787
NODE_ENV=development

# Azure App Service: use a persistent path such as /home/data/kitchenops-agent.
KITCHEN_DATA_DIR=./data

# Optional fallback provider.
OPENAI_API_KEY=

# Microsoft AI provider for hackathon submission.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Computer Vision provider for fixed-camera frame analysis.
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_API_KEY=

# Provider preference: mock | azure-openai | azure-ai-vision | openai
VISION_PROVIDER=mock
